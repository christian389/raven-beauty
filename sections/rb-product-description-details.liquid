{%- liquid
  assign max_width = 1400
  assign product_resource = closest.product | default: product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign meta_ingredients = blank
  if request.page_type == 'product' and product_resource != blank
    assign meta_ingredients = product_resource.metafields.custom.key_ingredients.value
  endif

  assign meta_reviews = blank
  assign meta_review = blank
  if request.page_type == 'product' and product_resource != blank
    assign meta_reviews = product_resource.metafields.custom.reviews.value
    for r in meta_reviews
      assign meta_review = r
      break
    endfor
  endif

  capture meta_ingredients_items
    for ingredient in meta_ingredients
      assign ing_name = ingredient.name | default: ingredient.name.value
      assign ing_desc = ingredient.description | default: ingredient.description.value

      if ing_name != blank or ing_desc != blank
        echo '<div class="rb-pdd__ingredient">'
        echo '<span class="rb-pdd__dot" aria-hidden="true"></span>'
        echo '<div class="rb-pdd__ingredient-body">'
        if ing_name != blank
          echo '<h4 class="rb-pdd__ingredient-title">'
          echo ing_name | escape
          echo '</h4>'
        endif
        if ing_desc != blank
          echo '<p class="rb-pdd__ingredient-text">'
          echo ing_desc | strip_html | escape
          echo '</p>'
        endif
        echo '</div></div>'
      endif
    endfor
  endcapture

  assign meta_ingredients_items_trimmed = meta_ingredients_items | strip
  assign has_key_ingredients = false
  if meta_ingredients_items_trimmed != blank
    assign has_key_ingredients = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }
</style>

<section
  class="rb-pdd spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %} background: {{ section.settings.background_color }};"
>
  <div class="rb-pdd__inner" style="--rb-pdd-max-width: {{ max_width }}px;">
    <div class="rb-pdd__grid">
      <div class="rb-pdd__main">
        <h2 class="rb-pdd__heading">Om produktet</h2>

        <div class="rb-pdd__body">
          {%- if request.page_type == 'product' and product_resource != blank and product_resource.description != blank -%}
            <div class="rb-pdd__para">{{ product_resource.description }}</div>
          {%- endif -%}
        </div>

        {%- if has_key_ingredients -%}
          <div class="rb-pdd__ingredients">
            <div class="rb-pdd__ingredients-head">
              <span class="rb-pdd__ingredients-icon" aria-hidden="true">
                {%- if section.settings.ingredients_icon != blank -%}
                  {{
                    section.settings.ingredients_icon
                    | image_url: width: 36
                    | image_tag: loading: 'lazy', widths: '18, 24, 36', sizes: '18px', alt: ''
                  }}
                {%- else -%}
                  <span class="rb-pdd__ingredients-icon-fallback"></span>
                {%- endif -%}
              </span>
              <h3 class="rb-pdd__ingredients-title">Nøgleingredienser</h3>
            </div>

            <div class="rb-pdd__ingredients-grid" role="list">
              {{ meta_ingredients_items_trimmed }}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="rb-pdd__side">
        {%- liquid
          assign how_to_use_html = blank
          assign who_is_it_for_html = blank
          assign how_to_use_plain = blank
          assign who_is_it_for_plain = blank
          if request.page_type == 'product' and product_resource != blank
            assign how_to_use_mf = product_resource.metafields.custom.how_to_use
            assign who_is_it_for_mf = product_resource.metafields.custom.who_is_it_for

            assign how_to_use_plain = how_to_use_mf.value | default: '' | strip_html | replace: '&nbsp;', '' | strip
            assign who_is_it_for_plain = who_is_it_for_mf.value | default: '' | strip_html | replace: '&nbsp;', '' | strip

            if how_to_use_mf != blank and how_to_use_plain != blank
              capture how_to_use_html
                echo how_to_use_mf | metafield_tag
              endcapture
            endif

            if who_is_it_for_mf != blank and who_is_it_for_plain != blank
              capture who_is_it_for_html
                echo who_is_it_for_mf | metafield_tag
              endcapture
            endif
          endif
        -%}

        {%- if how_to_use_plain != blank -%}
          <div class="rb-pdd__card">
            <div class="rb-pdd__card-head">
              {%- if section.settings.how_to_use_icon != blank -%}
                {{
                  section.settings.how_to_use_icon
                  | image_url: width: 40
                  | image_tag: loading: 'lazy', widths: '20, 30, 40', sizes: '20px', alt: ''
                }}
              {%- else -%}
                <span class="rb-pdd__card-icon-fallback" aria-hidden="true"></span>
              {%- endif -%}
              <h3 class="rb-pdd__card-title">Sådan bruges den</h3>
            </div>
            <div class="rb-pdd__card-text">{{ how_to_use_html }}</div>
          </div>
        {%- endif -%}

        {%- if who_is_it_for_plain != blank -%}
          <div class="rb-pdd__card">
            <div class="rb-pdd__card-head">
              {%- if section.settings.who_is_it_for_icon != blank -%}
                {{
                  section.settings.who_is_it_for_icon
                  | image_url: width: 40
                  | image_tag: loading: 'lazy', widths: '20, 30, 40', sizes: '20px', alt: ''
                }}
              {%- else -%}
                <span class="rb-pdd__card-icon-fallback" aria-hidden="true"></span>
              {%- endif -%}
              <h3 class="rb-pdd__card-title">Hvem er den til?</h3>
            </div>
            <div class="rb-pdd__card-text">{{ who_is_it_for_html }}</div>
          </div>
        {%- endif -%}

        {%- if meta_review != blank -%}
          {%- liquid
            assign review_rating = 5
            assign review_quote = blank
            assign review_author = blank

            if meta_review != blank
              assign review_quote = meta_review.text | default: meta_review.text.value
              assign review_author = meta_review.author | default: meta_review.author.value
              assign review_rating = meta_review.rating | default: meta_review.rating.value | default: 5
            endif
          -%}

          <div class="rb-pdd__review">
            <div class="rb-pdd__stars" aria-label="{{ 'accessibility.rating' | t | escape }}">
              {%- assign star_count = review_rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <span class="rb-pdd__star{% if i <= star_count %} rb-pdd__star--on{% endif %}" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="12" height="12" focusable="false" aria-hidden="true">
                    <path fill="currentColor" d="M10 1.25l2.6 5.38 5.93.86-4.29 4.18 1.01 5.9L10 14.96 4.75 17.57l1.01-5.9L1.47 7.49l5.93-.86L10 1.25z"/>
                  </svg>
                </span>
              {%- endfor -%}
            </div>

            {%- if review_quote != blank -%}
              <blockquote class="rb-pdd__quote">“{{ review_quote | strip_html | escape }}”</blockquote>
            {%- endif -%}
            {%- if review_author != blank -%}
              <div class="rb-pdd__author">— {{ review_author | strip_html | escape }}</div>
            {%- endif -%}

            {%- if section.settings.review_sticker != blank -%}
              <div class="rb-pdd__sticker" aria-hidden="true">
                {{
                  section.settings.review_sticker
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '80px', alt: ''
                }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .rb-pdd__inner {
    width: 100%;
    max-width: var(--rb-pdd-max-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .rb-pdd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding-top: 48px;
  }

  @media screen and (min-width: 990px) {
    .rb-pdd__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }
  }

  .rb-pdd__heading {
    margin: 0 0 24px 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    color: #131118;
  }

  .rb-pdd__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }

  .rb-pdd__para {
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    color: #4b5563;
  }

  .rb-pdd__para > :first-child {
    margin-top: 0;
  }
  .rb-pdd__para > :last-child {
    margin-bottom: 0;
  }

  .rb-pdd__ingredients {
    background: rgb(0 130 72 / 0.05);
    border-radius: 16px;
    padding: 40px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rb-pdd__ingredients-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rb-pdd__ingredients-icon {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .rb-pdd__ingredients-icon img {
    width: 18px;
    height: 18px;
    display: block;
    object-fit: contain;
  }

  .rb-pdd__ingredients-icon-fallback {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: rgb(0 130 72 / 0.35);
    display: block;
  }

  .rb-pdd__ingredients-title {
    margin: 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 28px;
    color: #131118;
  }

  .rb-pdd__ingredients-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .rb-pdd__ingredients-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .rb-pdd__ingredient {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-height: 44px;
  }

  .rb-pdd__dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #008248;
    margin-top: 12px;
    flex: 0 0 auto;
  }

  .rb-pdd__ingredient-title {
    margin: 0;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #131118;
  }

  .rb-pdd__ingredient-text {
    margin: 0;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #4b5563;
  }

  .rb-pdd__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .rb-pdd__card {
    background: #fdfbfc;
    border: 1px solid #f3f4f6;
    border-radius: 16px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .rb-pdd__card-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rb-pdd__card-head img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    display: block;
    flex: 0 0 auto;
  }

  .rb-pdd__card-icon-fallback {
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: rgb(0 130 72 / 0.18);
    display: block;
    flex: 0 0 auto;
  }

  .rb-pdd__card-title {
    margin: 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #131118;
  }

  .rb-pdd__card-text {
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 22.75px;
    color: #4b5563;
  }

  .rb-pdd__card-text > :first-child {
    margin-top: 0;
  }
  .rb-pdd__card-text > :last-child {
    margin-bottom: 0;
  }

  .rb-pdd__review {
    position: relative;
    background: #fff;
    border: 2px solid rgb(0 130 72 / 0.1);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: clip;
  }

  .rb-pdd__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #fbbf24;
  }

  .rb-pdd__star {
    color: rgb(251 191 36 / 0.45);
    display: inline-flex;
  }
  .rb-pdd__star--on {
    color: #fbbf24;
  }

  .rb-pdd__quote {
    margin: 0;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    color: #374151;
  }

  .rb-pdd__author {
    padding-top: 4px;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    color: #008248;
  }

  .rb-pdd__sticker {
    position: absolute;
    right: -14px;
    top: -14px;
    transform: rotate(12deg);
    width: 80px;
    height: 80px;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .rb-pdd__sticker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .rb-pdd__grid {
      padding-top: 32px;
    }

    .rb-pdd__ingredients {
      padding: 28px 20px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RB - Product details",
  "tag": "section",
  "class": "section rb-pdd-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F6F6F8"
    },
    {
      "type": "header",
      "content": "Icons (optional)"
    },
    {
      "type": "image_picker",
      "id": "ingredients_icon",
      "label": "Ingredients icon"
    },
    {
      "type": "image_picker",
      "id": "how_to_use_icon",
      "label": "How to use icon"
    },
    {
      "type": "image_picker",
      "id": "who_is_it_for_icon",
      "label": "Who is it for icon"
    },
    {
      "type": "image_picker",
      "id": "review_sticker",
      "label": "Review sticker image (optional)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "RB - Product details"
    }
  ]
}
{% endschema %}

