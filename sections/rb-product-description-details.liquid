{%- liquid
  assign max_width = 1400
  assign product_resource = closest.product | default: product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign meta_ingredients = blank
  if request.page_type == 'product' and product_resource != blank
    assign meta_ingredients = product_resource.metafields.custom.key_ingredients.value
  endif

  assign meta_reviews = blank
  assign meta_review = blank
  if request.page_type == 'product' and product_resource != blank
    assign meta_reviews = product_resource.metafields.custom.reviews.value
    for r in meta_reviews
      assign meta_review = r
      break
    endfor
  endif

  capture ingredients_items
    for block in section.blocks
      if block.type != 'ingredient'
        continue
      endif

      echo '<div class="rb-pdd__ingredient" '
      echo block.shopify_attributes
      echo '>'
      echo '<span class="rb-pdd__dot" aria-hidden="true"></span>'
      echo '<div class="rb-pdd__ingredient-body">'
      if block.settings.title != blank
        echo '<h4 class="rb-pdd__ingredient-title">'
        echo block.settings.title | escape
        echo '</h4>'
      endif
      if block.settings.text != blank
        echo '<p class="rb-pdd__ingredient-text">'
        echo block.settings.text | escape
        echo '</p>'
      endif
      echo '</div></div>'
    endfor
  endcapture

  capture meta_ingredients_items
    for ingredient in meta_ingredients
      assign ing_name = ingredient.name | default: ingredient.name.value
      assign ing_desc = ingredient.description | default: ingredient.description.value

      echo '<div class="rb-pdd__ingredient">'
      echo '<span class="rb-pdd__dot" aria-hidden="true"></span>'
      echo '<div class="rb-pdd__ingredient-body">'
      if ing_name != blank
        echo '<h4 class="rb-pdd__ingredient-title">'
        echo ing_name | escape
        echo '</h4>'
      endif
      if ing_desc != blank
        echo '<p class="rb-pdd__ingredient-text">'
        echo ing_desc | strip_html | escape
        echo '</p>'
      endif
      echo '</div></div>'
    endfor
  endcapture

  capture side_cards
    for block in section.blocks
      if block.type != 'info_card'
        continue
      endif

      assign card_text = block.settings.text
      if request.page_type == 'product' and product_resource != blank
        if block.settings.content_source == 'how_to_use'
          assign metafield_value = product_resource.metafields.custom.how_to_use.value
          if metafield_value != blank
            assign card_text = metafield_value
          endif
        elsif block.settings.content_source == 'who_is_it_for'
          assign metafield_value = product_resource.metafields.custom.who_is_it_for.value
          if metafield_value != blank
            assign card_text = metafield_value
          endif
        endif
      endif

      echo '<div class="rb-pdd__card" '
      echo block.shopify_attributes
      echo '>'

      echo '<div class="rb-pdd__card-head">'
      if block.settings.icon != blank
        echo block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', widths: '20, 30, 40', sizes: '20px', alt: ''
      else
        echo '<span class="rb-pdd__card-icon-fallback" aria-hidden="true"></span>'
      endif
      if block.settings.title != blank
        echo '<h3 class="rb-pdd__card-title">'
        echo block.settings.title | escape
        echo '</h3>'
      endif
      echo '</div>'

      if card_text != blank
        echo '<div class="rb-pdd__card-text">'
        echo card_text
        echo '</div>'
      endif

      echo '</div>'
    endfor
  endcapture

  assign review_block = blank
  for block in section.blocks
    if block.type == 'review'
      assign review_block = block
      break
    endif
  endfor
-%}

<section class="rb-pdd spacing-style color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="rb-pdd__inner" style="--rb-pdd-max-width: {{ max_width }}px;">
    <div class="rb-pdd__grid">
      <div class="rb-pdd__main">
        {%- if section.settings.heading != blank -%}
          <h2 class="rb-pdd__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <div class="rb-pdd__body">
          {%- if request.page_type == 'product' and product_resource != blank and product_resource.description != blank -%}
            <div class="rb-pdd__para">{{ product_resource.description }}</div>
          {%- else -%}
            {%- if section.settings.body_1 != blank -%}
              <div class="rb-pdd__para">{{ section.settings.body_1 }}</div>
            {%- endif -%}
            {%- if section.settings.body_2 != blank -%}
              <div class="rb-pdd__para">{{ section.settings.body_2 }}</div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="rb-pdd__ingredients" {% if ingredients_items == blank and meta_ingredients_items == blank %}hidden{% endif %}>
          <div class="rb-pdd__ingredients-head">
            <span class="rb-pdd__ingredients-icon" aria-hidden="true">
              {%- if section.settings.ingredients_icon != blank -%}
                {{
                  section.settings.ingredients_icon
                  | image_url: width: 36
                  | image_tag: loading: 'lazy', widths: '18, 24, 36', sizes: '18px', alt: ''
                }}
              {%- else -%}
                <span class="rb-pdd__ingredients-icon-fallback"></span>
              {%- endif -%}
            </span>
            <h3 class="rb-pdd__ingredients-title">{{ section.settings.ingredients_heading | escape }}</h3>
          </div>

          <div class="rb-pdd__ingredients-grid" role="list">
            {%- if meta_ingredients_items != blank -%}
              {{ meta_ingredients_items }}
            {%- else -%}
              {{ ingredients_items }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="rb-pdd__side">
        {{ side_cards }}

        {%- if meta_review != blank or review_block != blank -%}
          {%- liquid
            assign review_rating = 5
            assign review_quote = blank
            assign review_author = blank

            if meta_review != blank
              assign review_quote = meta_review.text | default: meta_review.text.value
              assign review_author = meta_review.author | default: meta_review.author.value
              assign review_rating = meta_review.rating | default: meta_review.rating.value | default: 5
            else
              assign review_quote = review_block.settings.quote
              assign review_author = review_block.settings.author
              assign review_rating = review_block.settings.rating | default: 5
            endif
          -%}

          <div class="rb-pdd__review" {% if review_block != blank %}{{ review_block.shopify_attributes }}{% endif %}>
            <div class="rb-pdd__stars" aria-label="{{ 'accessibility.rating' | t | escape }}">
              {%- assign star_count = review_rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <span class="rb-pdd__star{% if i <= star_count %} rb-pdd__star--on{% endif %}" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="12" height="12" focusable="false" aria-hidden="true">
                    <path fill="currentColor" d="M10 1.25l2.6 5.38 5.93.86-4.29 4.18 1.01 5.9L10 14.96 4.75 17.57l1.01-5.9L1.47 7.49l5.93-.86L10 1.25z"/>
                  </svg>
                </span>
              {%- endfor -%}
            </div>

            {%- if review_quote != blank -%}
              <blockquote class="rb-pdd__quote">“{{ review_quote | strip_html | escape }}”</blockquote>
            {%- endif -%}
            {%- if review_author != blank -%}
              <div class="rb-pdd__author">— {{ review_author | strip_html | escape }}</div>
            {%- endif -%}

            {%- if review_block != blank and review_block.settings.sticker != blank -%}
              <div class="rb-pdd__sticker" aria-hidden="true">
                {{
                  review_block.settings.sticker
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '80px', alt: ''
                }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .rb-pdd__inner {
    width: 100%;
    max-width: var(--rb-pdd-max-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .rb-pdd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding-top: 48px;
  }

  @media screen and (min-width: 990px) {
    .rb-pdd__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }
  }

  .rb-pdd__heading {
    margin: 0 0 24px 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    color: #131118;
  }

  .rb-pdd__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }

  .rb-pdd__para {
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    color: #4b5563;
  }

  .rb-pdd__para > :first-child {
    margin-top: 0;
  }
  .rb-pdd__para > :last-child {
    margin-bottom: 0;
  }

  .rb-pdd__ingredients {
    background: rgb(0 130 72 / 0.05);
    border-radius: 16px;
    padding: 40px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rb-pdd__ingredients-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rb-pdd__ingredients-icon {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .rb-pdd__ingredients-icon img {
    width: 18px;
    height: 18px;
    display: block;
    object-fit: contain;
  }

  .rb-pdd__ingredients-icon-fallback {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: rgb(0 130 72 / 0.35);
    display: block;
  }

  .rb-pdd__ingredients-title {
    margin: 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 28px;
    color: #131118;
  }

  .rb-pdd__ingredients-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .rb-pdd__ingredients-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .rb-pdd__ingredient {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-height: 44px;
  }

  .rb-pdd__dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #008248;
    margin-top: 12px;
    flex: 0 0 auto;
  }

  .rb-pdd__ingredient-title {
    margin: 0;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #131118;
  }

  .rb-pdd__ingredient-text {
    margin: 0;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #4b5563;
  }

  .rb-pdd__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .rb-pdd__card {
    background: #fdfbfc;
    border: 1px solid #f3f4f6;
    border-radius: 16px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .rb-pdd__card-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rb-pdd__card-head img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    display: block;
    flex: 0 0 auto;
  }

  .rb-pdd__card-icon-fallback {
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: rgb(0 130 72 / 0.18);
    display: block;
    flex: 0 0 auto;
  }

  .rb-pdd__card-title {
    margin: 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #131118;
  }

  .rb-pdd__card-text {
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 22.75px;
    color: #4b5563;
  }

  .rb-pdd__card-text > :first-child {
    margin-top: 0;
  }
  .rb-pdd__card-text > :last-child {
    margin-bottom: 0;
  }

  .rb-pdd__review {
    position: relative;
    background: #fff;
    border: 2px solid rgb(0 130 72 / 0.1);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: clip;
  }

  .rb-pdd__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #fbbf24;
  }

  .rb-pdd__star {
    color: rgb(251 191 36 / 0.45);
    display: inline-flex;
  }
  .rb-pdd__star--on {
    color: #fbbf24;
  }

  .rb-pdd__quote {
    margin: 0;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
    color: #374151;
  }

  .rb-pdd__author {
    padding-top: 4px;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    color: #008248;
  }

  .rb-pdd__sticker {
    position: absolute;
    right: -14px;
    top: -14px;
    transform: rotate(12deg);
    width: 80px;
    height: 80px;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .rb-pdd__sticker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .rb-pdd__grid {
      padding-top: 32px;
    }

    .rb-pdd__ingredients {
      padding: 28px 20px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RB - Product details",
  "tag": "section",
  "class": "section rb-pdd-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Om produktet"
    },
    {
      "type": "richtext",
      "id": "body_1",
      "label": "Body (paragraph 1)",
      "default": "<p>Clarins Hand &amp; Nail Treatment Cream er udviklet til at give dine hænder samme opmærksomhed som dit ansigt. Den silkebløde formel smelter ind i huden og giver langvarig fugt, samtidig med at den hjælper med at bevare hudens elasticitet og komfort.</p>"
    },
    {
      "type": "richtext",
      "id": "body_2",
      "label": "Body (paragraph 2)",
      "default": "<p>Cremen arbejder aktivt på at pleje både hud, negle og neglebånd. Resultatet er velplejede hænder, stærkere negle og en mere ensartet hudtone. Perfekt til dig, der ønsker synligt smukkere hænder – hver dag.</p>"
    },
    {
      "type": "header",
      "content": "Ingredients card"
    },
    {
      "type": "image_picker",
      "id": "ingredients_icon",
      "label": "Ingredients icon"
    },
    {
      "type": "text",
      "id": "ingredients_heading",
      "label": "Ingredients heading",
      "default": "Nøgleingredienser"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sheasmør"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Giver dybdegående næring og naturlig beskyttelse."
        }
      ]
    },
    {
      "type": "info_card",
      "name": "Info card",
      "settings": [
        {
          "type": "select",
          "id": "content_source",
          "label": "Content source",
          "options": [
            { "value": "manual", "label": "Manual" },
            { "value": "how_to_use", "label": "Product metafield: custom.how_to_use" },
            { "value": "who_is_it_for", "label": "Product metafield: custom.who_is_it_for" }
          ],
          "default": "manual"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sådan bruges den"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Påfør en lille mængde på rene, tørre hænder. Massér ind fra fingerspidserne og op mod håndleddet. Gentag efter behov i løbet af dagen.</p>"
        }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "Elsker hvor hurtigt den trænger ind – mine hænder føles silkebløde hele dagen."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sophie J., København"
        },
        {
          "type": "image_picker",
          "id": "sticker",
          "label": "Sticker image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RB - Product details",
      "blocks": [
        { "type": "ingredient" },
        {
          "type": "ingredient",
          "settings": {
            "title": "Sesamolie",
            "text": "Blødgør huden og øger elasticiteten."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Myrrha-ekstrakt",
            "text": "Styrker neglene og plejer neglebåndene."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Japansk morbærekstrakt",
            "text": "Støtter hudbarrieren og lysner hudtonen."
          }
        },
        { "type": "info_card" },
        {
          "type": "info_card",
          "settings": {
            "title": "Hvem er den til?",
            "text": "<p>Alle hudtyper. Særligt velegnet til dig med tørre hænder eller sarte neglebånd, der har brug for ekstra pleje og beskyttelse.</p>"
          }
        },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

