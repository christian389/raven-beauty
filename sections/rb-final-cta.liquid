{%- liquid
  assign max_width = 1400
-%}

<section class="rb-final-cta spacing-style color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="rb-final-cta__inner" style="--rb-final-cta-max-width: {{ max_width }}px;">
    <div class="rb-final-cta__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="rb-final-cta__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rb-final-cta__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="rb-final-cta__row">
        {%- if section.settings.price_text != blank -%}
          <div class="rb-final-cta__price">{{ section.settings.price_text | escape }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="rb-final-cta__button button" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="rb-final-cta__meta" role="list" aria-label="Fordele">
        <div class="rb-final-cta__meta-item" role="listitem">
          <span class="rb-final-cta__meta-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              {% render 'icon', icon: 'lock' %}
            </svg>
          </span>
          <span class="rb-final-cta__meta-text">{{ section.settings.meta_1 | escape }}</span>
        </div>
        <div class="rb-final-cta__meta-item" role="listitem">
          <span class="rb-final-cta__meta-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              {% render 'icon', icon: 'truck' %}
            </svg>
          </span>
          <span class="rb-final-cta__meta-text">{{ section.settings.meta_2 | escape }}</span>
        </div>
        <div class="rb-final-cta__meta-item" role="listitem">
          <span class="rb-final-cta__meta-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              {% render 'icon', icon: 'chat_bubble' %}
            </svg>
          </span>
          <span class="rb-final-cta__meta-text">{{ section.settings.meta_3 | escape }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .rb-final-cta__inner {
    width: 100%;
    max-width: var(--rb-final-cta-max-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .rb-final-cta__card {
    background: rgb(0 130 72 / 0.05);
    border: 2px solid rgb(0 130 72 / 0.2);
    border-radius: 24px;
    padding: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .rb-final-cta__heading {
    margin: 0;
    font-family: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 40px;
    color: #131118;
  }

  .rb-final-cta__text {
    max-width: 672px;
    color: #4b5563;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
  }

  .rb-final-cta__row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding-top: 16px;
    width: 100%;
    flex-wrap: wrap;
  }

  .rb-final-cta__price {
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    font-size: 30px;
    line-height: 36px;
    color: #008248;
    white-space: nowrap;
  }

  .rb-final-cta__button.button {
    background: #008248;
    border-radius: 8px;
    padding: 16px 48px;
    color: #fff;
    text-decoration: none;
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 28px;
    box-shadow: 0 20px 25px -5px rgb(0 130 72 / 0.3), 0 8px 10px -6px rgb(0 130 72 / 0.3);
  }

  .rb-final-cta__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding-top: 16px;
    width: 100%;
    flex-wrap: wrap;
  }

  .rb-final-cta__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .rb-final-cta__meta-icon,
  .rb-final-cta__meta-icon svg {
    width: 14px;
    height: 14px;
    color: #6b7280;
  }

  .rb-final-cta__meta-text {
    font-family: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #6b7280;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .rb-final-cta__card {
      padding: 40px 20px;
    }

    .rb-final-cta__heading {
      font-size: 28px;
      line-height: 34px;
    }

    .rb-final-cta__button.button {
      width: 100%;
      justify-content: center;
      padding-inline: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RB - Final CTA",
  "tag": "section",
  "class": "section rb-final-cta-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Giv dine hænder den pleje de fortjener"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tilmeld dig over 10.000+ glade kunder, der har gjort Clarins Hand & Nail til en fast del af deres daglige rutine.</p>"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price text",
      "default": "214,95 kr."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "🖤 Forkæl dine hænder i dag"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "meta_1",
      "label": "Meta 1",
      "default": "Sikker betaling"
    },
    {
      "type": "text",
      "id": "meta_2",
      "label": "Meta 2",
      "default": "Fri fragt v/ 499,-"
    },
    {
      "type": "text",
      "id": "meta_3",
      "label": "Meta 3",
      "default": "Kundesupport"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "RB - Final CTA"
    }
  ]
}
{% endschema %}

