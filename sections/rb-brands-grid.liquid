{%- liquid
  assign brands = shop.metaobjects.brands.values
-%}

<section
  class="rb-brands-grid spacing-style color-{{ section.settings.color_scheme }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --rbbg-bg: {{ section.settings.background_color }};
    --rbbg-max: {{ section.settings.max_width }}px;
    --rbbg-gap: {{ section.settings.cards_gap }}px;
    --rbbg-radius: {{ section.settings.cards_radius }}px;
    --rbbg-image-bg: {{ section.settings.image_background_color }};
    --rbbg-image-ratio: {{ section.settings.image_aspect_ratio }};
  "
>
  <div class="rb-brands-grid__container section section--page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="rb-brands-grid__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <div class="rb-brands-grid__grid" role="list">
      {%- for brand in brands -%}
        {%- liquid
          assign brand_field = brand.brand
          assign brand_name = brand_field.value | default: brand_field | default: brand.title | default: brand.system.handle
          if brand_name != blank
            assign brand_vendor_param = brand_name | url_encode
            assign brand_url = collections.all.url | append: '?filter.p.vendor=' | append: brand_vendor_param
          else
            assign brand_url = brand.system.url | default: brand.url
          endif
          assign brand_logo = brand.brand_logo
          assign brand_featured_image = brand.featured_image
        -%}

        <a
          class="rb-brands-grid__card"
          role="listitem"
          href="{{ brand_url }}"
          {% if brand_url == blank %}aria-disabled="true"{% endif %}
        >
          <div class="rb-brands-grid__card-media">
            {%- if brand_featured_image != blank -%}
              {{
                brand_featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  class: 'rb-brands-grid__card-image',
                  widths: '200, 320, 480, 640, 800',
                  sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                  alt: brand_name
              }}
            {%- endif -%}

            {%- if brand_logo != blank -%}
              <span class="rb-brands-grid__card-logo" aria-hidden="true">
                {{
                  brand_logo
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    class: 'rb-brands-grid__card-logo-image',
                    widths: '100, 150, 200',
                    sizes: '50px',
                    alt: ''
                }}
              </span>
            {%- endif -%}
          </div>

          <span class="rb-brands-grid__card-title">
            {{ brand_name | escape }}
          </span>
        </a>
      {%- else -%}
        <div class="rb-brands-grid__empty" role="listitem">
          <p class="rb-brands-grid__empty-text">
            No brands found yet.
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .rb-brands-grid {
    --raven-font-heading: 'Noto Serif', ui-serif, Georgia, 'Times New Roman', Times, serif;
    --raven-font-body: 'Noto Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    background: var(--rbbg-bg, transparent);
  }

  .rb-brands-grid__container {
    width: 100%;
    max-width: var(--rbbg-max, 1200px);
    margin-inline: auto;
  }

  .rb-brands-grid__heading {
    margin: 0 0 24px 0;
    font-family: var(--raven-font-heading);
    font-weight: 700;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .rb-brands-grid__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--rbbg-gap, 24px);
  }

  @media screen and (min-width: 750px) {
    .rb-brands-grid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .rb-brands-grid__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .rb-brands-grid__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: #0f172a;
    transition: transform 200ms ease;
  }

  .rb-brands-grid__card:focus-visible {
    outline: 2px solid #4713ae;
    outline-offset: 4px;
    border-radius: var(--rbbg-radius, 8px);
  }

  .rb-brands-grid__card[aria-disabled='true'] {
    pointer-events: none;
    opacity: 0.6;
  }

  .rb-brands-grid__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--rbbg-image-ratio, 3 / 4);
    background: var(--rbbg-image-bg, #f1f5f9);
    border-radius: var(--rbbg-radius, 8px);
    overflow: hidden;
  }

  .rb-brands-grid__card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .rb-brands-grid__card:hover .rb-brands-grid__card-image {
    transform: scale(1.04);
  }

  .rb-brands-grid__card-logo {
    position: absolute;
    top: 15px;
    left: 15px;
    width: 50px;
    height: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    z-index: 1;
    pointer-events: none;
  }

  .rb-brands-grid__card-logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    display: block;
  }

  .rb-brands-grid__card-title {
    font-family: var(--raven-font-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: inherit;
  }

  .rb-brands-grid__empty {
    grid-column: 1 / -1;
    padding: 24px;
    border-radius: var(--rbbg-radius, 8px);
    background: #ffffff;
    border: 1px dashed rgba(15, 23, 42, 0.18);
  }

  .rb-brands-grid__empty-text {
    margin: 0;
    font-family: var(--raven-font-body);
    font-size: 14px;
    line-height: 20px;
    color: #475569;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RB - Brands grid",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "alpha": true,
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 320,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "cards_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Card image"
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Image background",
      "default": "#f1f5f9"
    },
    {
      "type": "range",
      "id": "cards_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "2 / 3", "label": "Tall (2:3)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "RB - Brands grid",
      "category": "Raven Beauty"
    }
  ]
}
{% endschema %}
